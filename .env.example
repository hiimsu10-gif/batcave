# Copy to .env and fill in. Never commit the real .env.
# Local: sqlite. Production: postgresql+psycopg://user:pass@host:5432/suprm
DATABASE_URL=sqlite:///./suprm.db
SECRET_KEY=change-me-to-a-long-random-string
MEDIA_ROOT=./media
OUTBOX_ROOT=./outbox
BASE_URL=http://localhost:8000

# Business rules
PLATFORM_COMMISSION_PERCENT=0
MIN_PAYOUT_USD=10.00

# Your DDEX identity (apply for a DPID at https://dpid.ddex.net)
DDEX_PARTY_ID=PADPIDA0000000000X
DDEX_PARTY_NAME=Suprm Sounds
DEFAULT_LABEL_NAME=Suprm Sounds

# Identifier prefixes (UPC from GS1 US, ISRC registrant code from usisrc.org)
UPC_COMPANY_PREFIX=
ISRC_COUNTRY=US
ISRC_REGISTRANT=

# Stripe Connect (test keys start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage: local disk, or an S3-compatible bucket (Cloudflare R2 recommended)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: console (prints to log), smtp, or resend
EMAIL_BACKEND=console
EMAIL_FROM=Suprm Sounds <hello@suprmsounds.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Background jobs: true = run deliveries inside the web request (local dev only)
JOBS_INLINE=true
REQUIRE_ADMIN_2FA=true

# Legal pages
LEGAL_ENTITY_NAME=Suprm Sounds LLC
LEGAL_STATE=
LEGAL_ADDRESS=
SUPPORT_EMAIL=support@suprmsounds.com
LEGAL_VERSION=2026-09-25
