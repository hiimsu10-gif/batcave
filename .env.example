# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=sqlite:///./suprm.db
SECRET_KEY=change-me-to-a-long-random-string
MEDIA_ROOT=./media
OUTBOX_ROOT=./outbox
BASE_URL=http://localhost:8000

# Business rules
PLATFORM_COMMISSION_PERCENT=0
MIN_PAYOUT_USD=10.00

# Your DDEX identity (apply for a DPID at https://dpid.ddex.net)
DDEX_PARTY_ID=PADPIDA0000000000X
DDEX_PARTY_NAME=Suprm Sounds
DEFAULT_LABEL_NAME=Suprm Sounds

# Identifier prefixes (UPC from GS1 US, ISRC registrant code from usisrc.org)
UPC_COMPANY_PREFIX=
ISRC_COUNTRY=US
ISRC_REGISTRANT=

# Stripe Connect (test keys start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
